import folium
import geopy.distance
import time
from folium.plugins import AntPath

# Create map with title
my_map = folium.Map(location=[51.0, 2.0], zoom_start=5, control_scale=True)
my_map.get_root().html.add_child(folium.Element("""
    <h1 style='position: fixed; top: 10px; left: 50%; transform: translateX(-50%); z-index: 1000; background: white; padding: 15px; border-radius: 5px; font-size: 24px; font-weight: bold; text-align: center;'>
         Latency graph
        <br>
        <span style='font-size: 18px; font-weight: normal; color: gray;'>Latency_1</span>
        <br>
        <span style='font-size: 18px; font-weight: normal; color: gray;'>Latency-2</span>
    </h1>
"""))

# Geographic coordinates
latency_center_1_coords = (51.507, -0.589)
latency_center_2_coords = (51.127, -0.016)

# latency_center_4 POP coordinates
latency_center_4_uk_south_coords = (51.520, -0.098)
latency_center_4_amsterdam_coords = (52.370, 4.895)
latency_center_4_frankfurt_coords = (50.110, 8.682)

# latency_center_3 POP coordinates
latency_center_3_london3_coords = (51.51, -0.13)  # London-3 (Equinix LD3)
latency_center_3_london5_coords = (51.51, -0.13)  # London-5 (Equinix LD5)
latency_center_3_manchester_coords = (53.483, -2.200)

# Latency data with unique keys
latency_data = {
    ("latency_center_1", "latency_center_4_uk_south", "latency_center_3_london3", "blue"): (12, 8),
    ("latency_center_1", "latency_center_4_amsterdam", "latency_center_3_london3", "green"): (20, 12),
    ("latency_center_1", "latency_center_4_frankfurt", "latency_center_3_london3", "yellow"): (20, 12),
    ("latency_center_1", "latency_center_4_uk_south", "latency_center_3_manchester", "pink"): (12, 8),
    ("latency_center_1", "latency_center_4_amsterdam", "latency_center_3_manchester", "brown"): (20, 12),
    ("latency_center_1", "latency_center_4_frankfurt", "latency_center_3_manchester", "red"): (20, 12),
    ("latency_center_2", "latency_center_4_uk_south", "latency_center_3_london5", "blue"): (22, 8),
    ("latency_center_2", "latency_center_4_uk_south", "latency_center_3_london5", "green"): (22, 12),
    ("latency_center_2", "latency_center_4_uk_south", "latency_center_3_london5", "yellow"): (12, 12),
    ("latency_center_2", "latency_center_4_uk_south", "latency_center_3_manchester", "pink"): (12, 12),
    ("latency_center_2", "latency_center_4_amsterdam", "latency_center_3_manchester", "brown"): (20, 12),
    ("latency_center_2", "latency_center_4_frankfurt", "latency_center_3_manchester", "red"): (20, 12),
}

# Function to calculate distance
def calculate_distance(coord1, coord2):
    return geopy.distance.geodesic(coord1, coord2).miles

# Function to add an animated path
def add_animated_path(source, latency_center_4, latency_center_3, source_name, latency_center_4_name, latency_center_3_name, latency1, latency2, color):
    path = [source, latency_center_4, latency_center_3]
    folium.PolyLine(path, color=color, weight=3).add_to(my_map)
    AntPath(path, delay=400, weight=5, color=color).add_to(my_map)
    
    # Add latency and distance labels
    total_distance = calculate_distance(source, latency_center_3)
    popup_text = (f'<b>{latency_center_3_name}</b><br>Total Latency: {latency1 + latency2} ms'
                  f'<br>Distance: {total_distance:.2f} miles')
    folium.Marker(location=latency_center_3, popup=popup_text, icon=folium.Icon(color="red")).add_to(my_map)

    # Add source and destination markers
    folium.Marker(location=source, popup=f'<b>Source: {source_name}</b>',
                  icon=folium.Icon(color="blue")).add_to(my_map)
    folium.Marker(location=latency_center_4, popup=f'<b>Destination: {latency_center_4_name}</b>',
                  icon=folium.Icon(color="green")).add_to(my_map)

# Adding animated paths
for (source_name, latency_center_4_name, latency_center_3_name, color), (latency1, latency2) in latency_data.items():
    source_coords = latency_center_1_coords if source_name == "latency_center_1" else latency_center_2_coords
    latency_center_4_coords = latency_center_4_uk_south_coords if "uk_south" in latency_center_4_name else (
        latency_center_4_amsterdam_coords if "amsterdam" in latency_center_4_name else latency_center_4_frankfurt_coords)
    latency_center_3_coords = latency_center_3_london3_coords if "london3" in latency_center_3_name else (
        latency_center_3_london5_coords if "london5" in latency_center_3_name else latency_center_3_manchester_coords)
    
    add_animated_path(source_coords, latency_center_4_coords, latency_center_3_coords, source_name, latency_center_4_name, latency_center_3_name, latency1, latency2, color)

# Save the map
my_map.save("animated_latency_map.html")
print("Animated latency map saved as animated_latency_map.html")
