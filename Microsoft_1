# Create first map
my_map1 = folium.Map(location=[51.0, 2.0], zoom_start=5, control_scale=True)
my_map1.get_root().html.add_child(folium.Element("""
    <h1 style='position: fixed; top: 10px; left: 50%; transform: translateX(-50%); z-index: 1000; background: white; padding: 15px; border-radius: 5px; font-size: 24px; font-weight: bold; text-align: center;'>
         Based on Latency
        <br>
        <span style='font-size: 18px; font-weight: normal; color: gray;'>Lon  are the best Azure regions</span>
        <br>
        <span style='font-size: 18px; font-weight: normal; color: gray;'>performance</span>
    </h1>
"""))

# Create second map
my_map2 = folium.Map(location=[51.0, 2.0], zoom_start=5, control_scale=True)

# Geographic coordinates
locations = {
    "latenc1": (51.507, -0.589),
    "latency2": (51.127, -0.016),
    "Equinix-LD5 [azure_uk_south]": (51.505, -0.089),
